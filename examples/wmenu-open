#!/bin/sh
# With bin/ on PATH, bind this helper directly in Sway.
set -eu
url=$(wmenu -p URL </dev/null) || exit 0
[ -n "$url" ] || exit 0
case $# in
    0) exec bug -- "$url" ;;
    1) # Compatibility with the original FIFO-based binding.
       [ -p "$1" ] || { echo "expected a command FIFO" >&2; exit 2; }
       exec python3 -c 'import json, sys; print(json.dumps({"cmd": "open", "url": sys.argv[1]}))' "$url" > "$1" ;;
    *) echo "usage: wmenu-open [command-fifo]" >&2; exit 2 ;;
esac
