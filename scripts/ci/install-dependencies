#!/usr/bin/env bash
set -euo pipefail
case $(uname -s) in
    Linux)
        sudo apt-get update
        sudo apt-get install -y ca-certificates curl gnupg
        curl --fail --silent --show-error https://apt.llvm.org/llvm-snapshot.gpg.key | gpg --dearmor > /tmp/bug-llvm.gpg
        sudo install -m 644 /tmp/bug-llvm.gpg /usr/share/keyrings/bug-llvm.gpg
        echo 'deb [signed-by=/usr/share/keyrings/bug-llvm.gpg] https://apt.llvm.org/noble/ llvm-toolchain-noble-19 main' | sudo tee /etc/apt/sources.list.d/bug-llvm.list
        sudo apt-get update
        sudo apt-get install -y clang-19 lld-19 autoconf autoconf-archive automake bison flex gettext \
            build-essential git pkg-config nasm ninja-build zip unzip libtool libltdl-dev gperf \
            python3-venv patchelf libwayland-dev libxkbcommon-dev libxkbcommon-x11-dev libx11-dev libx11-xcb-dev libxcursor-dev \
            libxi-dev libxrandr-dev libxinerama-dev libxcb-icccm4-dev libgl1-mesa-dev \
            libegl1-mesa-dev libdrm-dev libpulse-dev libdbus-1-dev libudev-dev glslang-tools fonts-liberation2 \
            xvfb xauth xdotool xclip ccache
        python3 -m venv build/ci-python
        build/ci-python/bin/pip install cmake==3.31.6
        echo "$PWD/build/ci-python/bin" >> "$GITHUB_PATH"
        echo 'CC=clang-19' >> "$GITHUB_ENV"
        echo 'CXX=clang++-19' >> "$GITHUB_ENV"
        ;;
    Darwin)
        brew install autoconf autoconf-archive automake cmake libtool nasm ninja pkgconf ccache
        echo "CC=$(xcrun --find clang)" >> "$GITHUB_ENV"
        echo "CXX=$(xcrun --find clang++)" >> "$GITHUB_ENV"
        echo 'MACOSX_DEPLOYMENT_TARGET=15.0' >> "$GITHUB_ENV"
        ;;
    *) exit 1 ;;
esac
rustup toolchain install 1.99.0 --profile minimal --component rustfmt --component clippy
